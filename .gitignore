# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-hybrid-dev/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Generated QA screenshots and media
/artifacts/**/*.png
/artifacts/**/*.jpg
/artifacts/**/*.jpeg
/artifacts/**/*.webp
/artifacts/**/*.mp4

# Local QA artifacts
/artifacts/*
!/artifacts/v1-site-audit.md
!/artifacts/v1-design-integration-plan.md

# User-provided local audio fixtures; never include recordings in a code backup.
/references/Audio/
/references/audio/

# Local account database, secrets and development mail; never publish user data.
/.aenural-local/
