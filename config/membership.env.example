# Canonical membership environment example for AENural.
# Copy the values you need into Hostinger's Node application environment
# (production) or a local, git-ignored .env.local (development) — never
# commit real secrets, and never put secrets in NEXT_PUBLIC_* variables.
# Keep both release switches OFF until database/mail/staging checks pass.
# Public testing pages are OFF unless explicitly enabled. Set this to 1 at
# build AND runtime to open the preview without changing backend access.
NEXT_PUBLIC_AENURAL_SITE_PREVIEW=0 # Preview is OFF unless explicitly set to 1 (opt-in only since Step 5, S5-19).
# --- Controlled activation (Phase 4; see docs/authentication/controlled-activation.md) ---
# Membership is controlled ONLY by environment flags. It never auto-activates
# on deploy, and there is no public endpoint that can enable it.
#   * Production: AENURAL_MEMBERSHIP_ENABLED=1 enables public membership
#     (requires MySQL, SMTP, MAIL_FROM and AUTH_TRUSTED_IP_HEADER below —
#     the app refuses to start auth without them). Anything else, including
#     unset/0, means FULLY DISABLED: /api/auth/* and /api/membership/*
#     answer 404 and auth pages show an unavailable state. Production
#     NEVER falls back to SQLite for public membership.
#   * Owner-only test mode: AENURAL_OWNER_TEST_MODE=1 is the ONLY way to
#     run the private owner account without enabling public membership
#     (explicit opt-in; it is NOT implied by "not enabled"). Leave unset
#     or 0 on any public deploy. Owner mode uses its own SQLite database
#     and closes public sign-up.
#   * Development default is ON (local SQLite) unless
#     AENURAL_MEMBERSHIP_DISABLED=1.
AENURAL_MEMBERSHIP_ENABLED=0
# AENURAL_OWNER_TEST_MODE=
# AENURAL_MEMBERSHIP_DISABLED=
# --- Owner activation (Step 5/6; see docs/authentication/owner-activation-rotation.md) ---
# Owner-only test mode needs the real owner email and a scrypt token hash.
# Generate both values with: node scripts/membership/generate-owner-token.mjs
# (run on your own PC; the token is printed once and never written to a file).
# Replace <redacted> with the real values. The placeholder owner@aenural.com
# is rejected by the code, and the old committed SHA-256 hash is compromised
# — never reuse a token whose hash was ever committed to the repo.
AENURAL_OWNER_EMAIL=<redacted>
AENURAL_OWNER_ACTIVATION_TOKEN_HASH=<redacted>
# --- Owner-mode SQLite data directories (optional, owner-mode only) ---
# The code reads these as data-directory overrides; both have defaults and
# are irrelevant to the production MySQL path — do not set them for a
# normal MySQL deploy.
# AENURAL_OWNER_DATA_DIR=.aenural-local/owner
# AENURAL_LOCAL_DATA_DIR=.aenural-local
NEXT_PUBLIC_AENURAL_AUTO_CAPTION_RELEASE=0
SITE_URL=https://aenural.com
BETTER_AUTH_URL=https://aenural.com
# At least 32 characters. Generate locally; never reuse a placeholder.
BETTER_AUTH_SECRET=
# Force MySQL in development (default dev run uses local SQLite):
# AENURAL_MEMBERSHIP_DATABASE=mysql
AENURAL_MEMBERSHIP_DATABASE=
# --- MySQL ---
# Production (app on Hostinger): DB_HOST=127.0.0.1, plain loopback, no TLS.
# Never use `localhost` (Node resolves it to IPv6 ::1, which Hostinger
# MySQL rejects) and never use the remote hostname inside Hostinger.
# Remote development (PC -> Hostinger over the internet): use the
# srv*.hstgr.io hostname and verified TLS (see below).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
# --- Remote MySQL TLS (only for a non-loopback DB_HOST) ---
# Remote connections are refused unless TLS can be verified.
# Option 1 (preferred if Hostinger provides a CA): path to a PEM CA bundle
# on disk. The file is read at startup; its contents are never put in env.
# DB_SSL_CA_FILE=/path/to/hostinger-mysql-ca.pem
DB_SSL_CA_FILE=
# Option 2: set to 1 ONLY if the server certificate chains to a public CA
# in Node's built-in trust store. Verification stays on
# (rejectUnauthorized is always true). Whether srv*.hstgr.io qualifies is
# UNVERIFIED — probe it from the allowlisted PC first; if the cert is
# privately signed, use Option 1 or an SSH tunnel instead. Never disable
# verification. Leave unset/0 unless you have verified the public chain.
DB_TLS_ALLOW_PUBLIC_CA=
# --- SMTP (Hostinger Email; Titan mailboxes use smtp.titan.email instead) ---
# Port 465 = implicit TLS (SMTP_SECURE=true). Port 587 = STARTTLS
# (SMTP_SECURE=false). Do not mix the pairs.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=support@aenural.com
SMTP_PASSWORD=
MAIL_FROM=support@aenural.com
# --- Email transport ---
# Email verification uses a 6-digit OTP (5-minute expiry, 5 attempts).
# How account mail is sent:
#   * Leave unset (default): SMTP whenever the SMTP_* variables above are
#     set. If SMTP is configured but sending fails, signup/verification
#     fails in the server log — there is NO silent fallback to disk.
#     In local mode with no SMTP configured, sending fails loudly at
#     send time instead of silently writing mail files.
#   * AENURAL_EMAIL_TRANSPORT=smtp: require the SMTP variables above.
#   * AENURAL_EMAIL_TRANSPORT=local-outbox: write each account email as
#     mail-*.json in the local data directory (mode 0600). Local/SQLite
#     development and tests ONLY — outbox files contain live
#     verification codes. Setting it in production is a startup error.
#     The membership test suite sets this flag itself.
# AENURAL_EMAIL_TRANSPORT=
# Trusted proxy IP header — RECOMMENDED value: x-real-ip (see
# docs/authentication/trusted-proxy-ip.md). Hostinger's own CDN doc says
# Node.js apps should read X-Real-IP, or only the last entry of
# X-Forwarded-For, and never CF-Connecting-IP. Better Auth reads the FIRST
# header listed that holds a valid address, and without trustedProxies it
# cannot safely use a multi-entry X-Forwarded-For — so x-real-ip (a
# single value overwritten by Hostinger CDN) is the safe choice. Confirm
# in hPanel that Hostinger CDN is enabled for aenural.com and that no
# Cloudflare/other proxy sits in front; if either check fails, STOP and ask
# Hostinger support (exact question in the doc above) — do not substitute
# x-forwarded-for or cf-connecting-ip on a guess.
AUTH_TRUSTED_IP_HEADER=x-real-ip

# Lemon Squeezy: $20 USD, one-time variant, quantity 1, no subscription/discount.
# Webhook URL: https://aenural.com/api/payments/webhook
# Events: order_created and order_refunded. Create a strong webhook secret.
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_TEST_MODE=1
# Sales are a separate switch; verified refunds still process while sales are closed.
AENURAL_SALES_ENABLED=0
