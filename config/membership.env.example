# Set these in Hostinger's Node application environment, never in NEXT_PUBLIC_* secrets.
# Keep both release switches OFF until database/mail/staging checks pass.
AENURAL_MEMBERSHIP_ENABLED=0
NEXT_PUBLIC_AENURAL_AUTO_CAPTION_RELEASE=0
SITE_URL=https://aenural.com
BETTER_AUTH_URL=https://aenural.com
BETTER_AUTH_SECRET=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Ask Hostinger which incoming header its trusted proxy overwrites with the real IP.
AUTH_TRUSTED_IP_HEADER=

# Lemon Squeezy: $20 USD, one-time variant, quantity 1, no subscription/discount.
# Webhook URL: https://aenural.com/api/payments/webhook
# Events: order_created and order_refunded. Create a strong webhook secret.
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_TEST_MODE=1
# Sales are a separate switch; verified refunds still process while sales are closed.
AENURAL_SALES_ENABLED=0
